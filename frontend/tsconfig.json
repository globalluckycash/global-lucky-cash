{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@artifacts/*": ["../artifacts/*"],
      "@docs/*": ["../docs/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
